{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prophec-y.local/reference_hardware/manifest.schema.json",
  "title": "Prophec-y Prophet-6 controlled capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capture_set_id", "hardware", "acquisition", "tests"],
  "properties": {
    "schema_version": {"const": "p6-reference-capture/1"},
    "capture_set_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "captured_utc": {"type": "string", "format": "date-time"},
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "unit_id", "firmware"],
      "properties": {
        "model": {"const": "Sequential Prophet-6"},
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "description": "Pseudonymous hardware identifier such as P6-A; do not store a serial number."
        },
        "firmware": {"type": "string", "minLength": 1},
        "warmup_minutes": {"type": "number", "minimum": 0},
        "voice_selection": {"type": "string"},
        "globals": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate_hz",
        "bit_depth",
        "channels",
        "format",
        "interface_chain",
        "fixed_gain_reference"
      ],
      "properties": {
        "sample_rate_hz": {"type": "integer", "minimum": 8000},
        "bit_depth": {"type": "integer", "minimum": 8},
        "channels": {"type": "integer", "minimum": 1},
        "format": {"const": "WAV_PCM"},
        "interface_chain": {"type": "string", "minLength": 1},
        "fixed_gain_reference": {"type": "string", "minLength": 1},
        "output_route": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "default_isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fx_off": {"type": "boolean"},
        "distortion_raw": {"type": "integer", "minimum": 0},
        "pan_spread_raw": {"type": "integer", "minimum": 0},
        "slop_raw": {"type": "integer", "minimum": 0},
        "lfo_destinations_off": {"type": "boolean"},
        "poly_mod_destinations_off": {"type": "boolean"},
        "velocity_modulation_off": {"type": "boolean"},
        "aftertouch_modulation_off": {"type": "boolean"}
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/test"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "test_id",
        "family",
        "capture_grade",
        "sysex_file",
        "audio_file",
        "midi",
        "timing"
      ],
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "test_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z0-9._-]+$"
        },
        "family": {"enum": ["P0-A", "P0-B", "P0-C", "P0-D", "P0-E", "P0-F", "P0-G"]},
        "capture_grade": {"enum": ["calibration", "diagnostic"]},
        "sysex_file": {"type": "string", "minLength": 1},
        "audio_file": {"type": "string", "minLength": 1},
        "midi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["notes", "velocities"],
          "properties": {
            "notes": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "minimum": 0, "maximum": 127}
            },
            "velocities": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "minimum": 1, "maximum": 127}
            },
            "channel_pressure": {"type": "integer", "minimum": 0, "maximum": 127},
            "mod_wheel": {"type": "integer", "minimum": 0, "maximum": 127},
            "pitch_bend_14bit": {"type": "integer", "minimum": 0, "maximum": 16383},
            "sustain": {"type": "boolean"}
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_roll_seconds", "note_seconds", "release_seconds"],
          "properties": {
            "pre_roll_seconds": {"type": "number", "minimum": 0},
            "note_seconds": {"type": "number", "exclusiveMinimum": 0},
            "release_seconds": {"type": "number", "minimum": 0}
          }
        },
        "raw_parameters": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]+$"},
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 16383},
          "description": "Optional human-auditable subset of NRPN raw values. The SysEx file remains the complete state authority."
        },
        "isolation_deviations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
